# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
# Default Gemini model ('gemini-4-hydrogen', 'gemini-3.8-flash', 'gemini-4-argon', 'gemini-4-neon', 'gemini-4-carbon')
GEMINI_MODEL=gemini-4-hydrogen

# (Optional) For Google Cloud Vertex AI
# USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your_gcp_project_id
# GOOGLE_CLOUD_LOCATION=us-central1

# Tavily Search & Extract API Configuration
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# Persistence Backend: 'sqlite' (default local) or 'firestore' (Firebase / Emulator)
# REPORT_STORAGE_BACKEND=firestore
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Async Job Dispatcher: 'local' (default) or 'cloud_tasks' (Cloud Run prod)
# JOB_DISPATCHER=cloud_tasks
# CLOUD_TASKS_QUEUE_PATH=projects/<project>/locations/<region>/queues/<queue>
# WORKER_BASE_URL=https://your-cloud-run-service.run.app
# CLOUD_TASKS_SERVICE_ACCOUNT_EMAIL=worker@<project>.iam.gserviceaccount.com
# INTERNAL_WORKER_SECRET=change_me

# Developer debug endpoints (keeps /api/v1/query-plan hidden unless true)
# CARTHIJ_DEV_TOOLS=false

# Server Settings
PORT=8000
